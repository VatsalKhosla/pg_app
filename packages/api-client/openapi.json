{
  "openapi": "3.1.0",
  "info": {
    "title": "YourBrand API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness: the process is up",
        "operationId": "systemHealthz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Readiness: the database and Redis are reachable",
        "operationId": "systemReadyz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/csrf": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "A CSRF token for this browser",
        "description": "Sets the CSRF cookie and returns the same value, bound to the browser's session cookie if\nit has one. Fetch a new one after signing in or out.",
        "operationId": "identityCsrfToken",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfToken"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp/request": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Send a sign-in code by SMS",
        "description": "Sends a six-digit code to the phone, replacing any earlier code. The answer is the same\nwhether or not the number has an account.",
        "operationId": "identityRequestOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpChallengeIssued"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp/verify": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Sign in with the code",
        "description": "Checks the code and signs the phone's owner in, creating the account on first sign-in.\nSets the session and CSRF cookies; any earlier session in this browser ends.",
        "operationId": "identityVerifyOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerify"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResult"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Sign out here",
        "description": "Ends this browser's session, if it has one, and clears the cookies. Safe to repeat.",
        "operationId": "identityLogout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout-everywhere": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Sign out on every device",
        "operationId": "identityLogoutEverywhere",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "The signed-in user",
        "description": "The account, with the roles this session carries (a phone sign-in never carries staff\nroles).",
        "operationId": "identityMe",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/sessions": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Where this account is signed in",
        "operationId": "identityMySessions",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionList"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/sessions/{session_id}": {
      "delete": {
        "tags": [
          "identity"
        ],
        "summary": "Sign out one device",
        "description": "Another user's session answers 404, like one that doesn't exist.",
        "operationId": "identityEndSession",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CsrfToken": {
        "properties": {
          "csrfToken": {
            "type": "string",
            "title": "Csrftoken"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "csrfToken"
        ],
        "title": "CsrfToken",
        "description": "Send this value in the X-CSRF-Token header of every POST, PUT, PATCH and DELETE."
      },
      "FieldError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "pointer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pointer"
          },
          "parameter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameter"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail",
          "code"
        ],
        "title": "FieldError",
        "description": "One invalid input. ``pointer`` locates a body field (JSON Pointer, e.g. ``/moveIn``);\n``parameter`` names a query, path, header or cookie parameter."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health",
        "description": "Liveness: the process is up and serving requests."
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "type": "array",
            "title": "Roles"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "phone",
          "email",
          "name",
          "roles"
        ],
        "title": "Me",
        "description": "The signed-in user."
      },
      "OtpChallengeIssued": {
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "title": "Challengeid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Expiresat"
          },
          "resendAfter": {
            "type": "string",
            "format": "date-time",
            "title": "Resendafter"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challengeId",
          "expiresAt",
          "resendAfter"
        ],
        "title": "OtpChallengeIssued",
        "description": "A code is on its way. Send it back with ``challengeId`` to sign in."
      },
      "OtpRequest": {
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 32,
            "title": "Phone"
          },
          "humanCheckToken": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Humanchecktoken",
            "description": "The token of the sign-in form's Cloudflare Turnstile widget, whose action is `otp_request`."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "phone",
          "humanCheckToken"
        ],
        "title": "OtpRequest",
        "description": "Ask for a sign-in code by SMS."
      },
      "OtpVerify": {
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "title": "Challengeid"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challengeId",
          "code"
        ],
        "title": "OtpVerify"
      },
      "ProblemDetail": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestid"
          },
          "traceId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Traceid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetail"
      },
      "Readiness": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ok",
                "unavailable"
              ]
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "Readiness",
        "description": "Readiness: whether this instance can serve traffic, with the state of each dependency."
      },
      "Role": {
        "type": "string",
        "enum": [
          "student",
          "parent",
          "owner",
          "field_agent",
          "ops",
          "admin"
        ],
        "title": "Role"
      },
      "SessionInfo": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "current": {
            "type": "boolean",
            "title": "Current"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Startedat"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time",
            "title": "Lastseenat"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Expiresat"
          },
          "userAgent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Useragent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "current",
          "startedAt",
          "lastSeenAt",
          "expiresAt",
          "userAgent"
        ],
        "title": "SessionInfo",
        "description": "One browser or device where the account is signed in."
      },
      "SessionList": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionInfo"
            },
            "type": "array",
            "title": "Sessions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sessions"
        ],
        "title": "SessionList"
      },
      "SignInResult": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/Me"
          },
          "csrfToken": {
            "type": "string",
            "title": "Csrftoken"
          },
          "newUser": {
            "type": "boolean",
            "title": "Newuser"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user",
          "csrfToken",
          "newUser"
        ],
        "title": "SignInResult",
        "description": "Signed in, with the session cookie set. Use ``csrfToken`` (also a cookie) from now on."
      }
    }
  }
}
