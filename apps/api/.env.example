# API settings for local development. `make setup` copies this to apps/api/.env (git-ignored).
# This file is committed: dummy values only, never real secrets. The values match the services in
# infra/docker-compose.yml (`make infra-up`).
APP_ENV=local
# Keys the HMACs that pseudonymise personal data (rate-limit keys, OTP codes) and derives staff
# authenticator secrets: rotating it means staff set up their authenticator apps again. At least
# 32 characters; a real random value in every deployed environment.
SECRET_KEY=local-development-only-0123456789abcdef
LOG_LEVEL=INFO
# console: readable lines for local work; deployed environments use json.
LOG_FORMAT=console

DATABASE_URL=postgresql+asyncpg://platform:platform@127.0.0.1:5432/platform
REDIS_URL=redis://:platform@127.0.0.1:6379/0

# Exact browser origins allowed to call the API (comma-separated): the web app's, which is also
# where Turnstile challenges are solved. Required when deployed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sign-in codes. "console" writes them to the API's log instead of texting them (local only; a
# deployed environment needs the SMS provider the founders choose). Without a Turnstile secret every
# human check passes; Cloudflare's always-pass test secret 1x0000000000000000000000000000000AA
# exercises the real check against the test site key (local and staging; production refuses it).
OTP_SENDER=console
TURNSTILE_SECRET_KEY=

# Session and CSRF cookies apply to this parent domain (".example.com") when the web app and the
# API are on sibling subdomains; empty for host-only cookies, as in local development.
SESSION_COOKIE_DOMAIN=

# The web app's and the API's own public addresses (https when deployed). Staff land on
# SITE_URL/staff after signing in with Google; Google sends them back to
# API_URL/v1/auth/staff/google/callback, which must be the OAuth client's redirect URI.
SITE_URL=http://localhost:3000
API_URL=http://localhost:8000

# Shared with the web app (its REVALIDATE_SECRET): signs the requests that tell it a listing's
# pages are out of date (ADR 0032). Empty: nothing is sent, and the web app's cached data expires
# within a minute. At least 32 characters, the same random value on both sides; required when
# deployed.
REVALIDATE_SECRET=

# Staff sign-in with Google: the OAuth client ("Web application") of the founders' Google Cloud
# project. Empty: Google sign-in answers "unavailable", and staff sign in with a phone code plus an
# authenticator app (python -m app.manage staff enrol-authenticator). Who may use Google sign-in,
# comma-separated: Google Workspace domains and single addresses. They must also be made staff
# (python -m app.manage staff add PHONE --role ops --email ADDRESS).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_GOOGLE_DOMAINS=
STAFF_GOOGLE_EMAILS=

# The version of the privacy notice the web app shows (DPDP). Every consent records it, and
# changing it asks everyone to agree again. A version starting "draft" (not yet reviewed by a
# lawyer) is refused in production.
PRIVACY_NOTICE_VERSION=draft-1

# The owner agreement owners accept: a file in src/app/modules/catalog/data/agreements. Changing it
# asks every owner to accept again; production refuses a draft.
OWNER_AGREEMENT_VERSION=draft-2

# Error reporting and tracing stay off while these are empty.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Background worker: concurrent job consumers and how often an idle consumer looks for work.
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1

# Read from step 2.3 (media) and the notification steps onwards.
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=pg-platform-dev
S3_SECRET_ACCESS_KEY=pg-platform-dev-only
# Uploads and private files; listing media anyone may see (the CDN's address when deployed).
MEDIA_PRIVATE_BUCKET=pg-platform-private
MEDIA_PUBLIC_BUCKET=pg-platform-media
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:8333/pg-platform-media
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
