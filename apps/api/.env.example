# API settings for local development. `make setup` copies this to apps/api/.env (git-ignored).
# This file is committed: dummy values only, never real secrets. The values match the services in
# infra/docker-compose.yml (`make infra-up`).
APP_ENV=local
# Keys the HMACs that pseudonymise personal data (rate-limit keys, OTP codes). At least 32
# characters; a real random value in every deployed environment.
SECRET_KEY=local-development-only-0123456789abcdef
LOG_LEVEL=INFO
# console: readable lines for local work; deployed environments use json.
LOG_FORMAT=console

DATABASE_URL=postgresql+asyncpg://platform:platform@127.0.0.1:5432/platform
REDIS_URL=redis://:platform@127.0.0.1:6379/0

# Exact browser origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Error reporting and tracing stay off while these are empty.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Background worker: concurrent job consumers and how often an idle consumer looks for work.
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1

# Read from step 2.3 (media) and the notification steps onwards.
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=pg-platform-dev
S3_SECRET_ACCESS_KEY=pg-platform-dev-only
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
