# The web image's build (context: the repository) sees only what is listed here: everything
# else, including any .env file, node_modules, build output, caches and tests, stays out.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!packages/api-client/
!apps/web/
apps/web/.env*
apps/web/.next/
apps/web/node_modules/
apps/web/playwright-report/
apps/web/test-results/
apps/web/tests/
apps/web/playwright.config.ts
apps/web/vitest.config.mts
apps/web/tsconfig.tsbuildinfo
packages/api-client/node_modules/
**/*.test.ts
**/*.test.tsx
