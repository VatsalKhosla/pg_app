# Web settings for local development. Copy to apps/web/.env.local (git-ignored) and adjust.
# This file is committed: dummy values only. Anything prefixed NEXT_PUBLIC_ is built into the
# browser bundle, so only truly public values may use that prefix.

# local, test, staging or production (the API's APP_ENV names). Staging is kept out of search.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Where the web server itself reaches the API (an internal address in production). Empty: the
# public URL above. Read at start-up, never sent to the browser.
API_URL=

# Error reporting is off while these are empty. The browser DSN is public by design; the server
# one is read at start-up.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
