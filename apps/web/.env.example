# Web settings for local development. Copy to apps/web/.env.local (git-ignored) and adjust.
# This file is committed: dummy values only. Anything prefixed NEXT_PUBLIC_ is built into the
# browser bundle, so only truly public values may use that prefix.

# local, test, staging or production (the API's APP_ENV names). Staging is kept out of search.
NEXT_PUBLIC_APP_ENV=local
# Keep the site and the API on one host (both localhost here; sibling subdomains when deployed):
# the browser only shares the API's session cookie with the web server within one site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the web server itself reaches the API (an internal address in production). Empty: the
# public URL above. Read at start-up, never sent to the browser.
API_URL=
# Shared with the API (its REVALIDATE_SECRET): checks the requests that say a listing's pages are
# out of date (POST /api/revalidate, ADR 0032). Empty: that route answers 404, and cached data
# expires on its own within a minute. Read at start-up, never sent to the browser.
REVALIDATE_SECRET=

# Error reporting is off while these are empty. The browser DSN is public by design; the server
# one is read at start-up.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Cloudflare Turnstile's site key, for the human check on the sign-in form (public by design).
# Empty: no widget, as the API checks nothing without its secret. Cloudflare's always-pass test
# key is 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Listing photos: where the browser reads them (the CDN when deployed) and where it posts uploads
# (the private bucket's storage). Locally both are SeaweedFS (`make seed` makes the buckets).
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:8333/pg-platform-media
NEXT_PUBLIC_UPLOAD_ORIGIN=http://127.0.0.1:8333
# Raster map tiles for the ops pin picker, as an https:// {z}/{x}/{y} template, and the credit
# their terms require (plain text). Empty: OpenStreetMap's tile servers when NEXT_PUBLIC_APP_ENV is
# local (light use only, by their policy), and no map elsewhere, where ops place the pin by GPS or
# coordinates instead. Set both to the map provider's when deployed.
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_TILES_ATTRIBUTION=
