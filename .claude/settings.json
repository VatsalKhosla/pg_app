{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make setup)",
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test-api)",
      "Bash(make test-web)",
      "Bash(make e2e)",
      "Bash(make migrate)",
      "Bash(make seed)",
      "Bash(make gen-client)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(/packages/api-client/src/generated/**)"
    ]
  }
}
